{
  "name": "taskcenter",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "stack:up": "podman-compose up -d",
    "stack:down": "podman-compose down",
    "stack:logs": "podman-compose logs -f postgres",
    "typecheck": "for p in apps/* packages/*; do tsc --noEmit -p \"$p\" || exit 1; done",
    "verify": "node scripts/verify.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:tasks": "node scripts/verify-tasks.mjs",
    "dev:auth": "pnpm --filter @taskcenter/auth-service start",
    "dev:task": "pnpm --filter @taskcenter/task-service start",
    "dev:gateway": "pnpm --filter @taskcenter/api-gateway start"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
