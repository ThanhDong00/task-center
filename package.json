{
  "name": "taskcenter",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "stack:up": "podman-compose up -d",
    "stack:down": "podman-compose down",
    "stack:logs": "podman-compose logs -f postgres",
    "typecheck": "for p in apps/* packages/*; do tsc --noEmit -p \"$p\" || exit 1; done",
    "verify": "node scripts/verify.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:tasks": "node scripts/verify-tasks.mjs",
    "verify:groups": "node scripts/verify-groups.mjs",
    "verify:group-tasks": "node scripts/verify-group-tasks.mjs",
    "verify:notifications": "node scripts/verify-notifications.mjs",
    "verify:web": "node scripts/verify-web.mjs",
    "dev:auth": "pnpm --filter @taskcenter/auth-service start",
    "dev:task": "pnpm --filter @taskcenter/task-service start",
    "dev:group": "pnpm --filter @taskcenter/group-service start",
    "dev:gateway": "pnpm --filter @taskcenter/api-gateway start",
    "dev:notif": "pnpm --filter @taskcenter/notification-service start",
    "dev:all": "concurrently -n gateway,auth,task,group,notif -c auto \"pnpm dev:gateway\" \"pnpm dev:auth\" \"pnpm dev:task\" \"pnpm dev:group\" \"pnpm dev:notif\"",
    "dev:web": "pnpm --filter @taskcenter/web dev",
    "build:web": "pnpm --filter @taskcenter/web build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.5",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3"
  }
}
